APP_NAME="WP Marine Limited"
APP_ENV=local
APP_KEY=base64:RandomlyGeneratedKeyHere123456789012345678901234=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wpmarine
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@wpmarinelimited.com"
MAIL_FROM_NAME="${APP_NAME}"

RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

LIVE_CHAT_ENABLED=true
LIVE_CHAT_SCRIPT=your_live_chat_script

FILESYSTEM_CLOUD=local
UPLOAD_MAX_SIZE=5120
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

GDPR_ENABLED=true
GDPR_COOKIE_BANNER=true

CACHE_PREFIX=wpmarine
